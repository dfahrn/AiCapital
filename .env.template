# AI Hedge Fund Simulator Configuration
# Copy this file to .env and fill in your keys.

# ---------------------------------------------------------------------------
# LLM provider (required)
#
# The agents use any OpenAI-compatible chat-completions endpoint, so several
# free providers work. Uncomment one block below.
# ---------------------------------------------------------------------------

# --- Groq free tier (default) ---
# Get a free key at https://console.groq.com/keys  (no credit card)
# Chosen as the default because a full cycle makes ~48 calls, which does not
# fit Gemini's free tier (20 requests/day per model).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b
# Model names change; run `python check_llm.py --list` to see what your key can use.

# --- Google Gemini free tier ---
# Get a free key at https://aistudio.google.com/apikey  (no credit card)
# NOTE: the free tier is only 20 requests/day and 5/minute per model, so a full
# cycle will not complete. Use SYMBOLS_PER_ANALYST=1 and LLM_REQUEST_DELAY=13.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini-3.6-flash

# --- OpenRouter free models ---
# Get a free key at https://openrouter.ai/keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your_openrouter_api_key_here
# LLM_MODEL=deepseek/deepseek-chat-v3-0324:free
# LLM_JSON_MODE=false   # many :free models do not support JSON mode

# --- Local Ollama (no signup, runs offline) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1

# --- OpenAI (paid) ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini

# Set to false if the model does not support OpenAI JSON mode.
# LLM_JSON_MODE=true

# Retries for transient errors such as free-tier rate limits.
# LLM_MAX_RETRIES=3

# Minimum seconds between LLM calls, measured from the previous request.
# Groq's free tier is generous; on Gemini (5 requests/minute) set this to 13.
# LLM_REQUEST_DELAY=0

# Symbols each analyst researches per cycle. This is the main driver of cost:
# a full cycle makes 8 x (1 + SYMBOLS_PER_ANALYST) LLM calls.
#   5 (default) = 48 calls    2 = 24 calls    1 = 16 calls
# Groq's free tier handles 48 comfortably. Gemini's does not (20/day per model).
# SYMBOLS_PER_ANALYST=5

# ---------------------------------------------------------------------------
# Alpaca paper trading (required to execute trades)
# Free paper account at https://alpaca.markets  (Home -> API Keys -> Generate)
# ---------------------------------------------------------------------------
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Alpha Vantage, for additional market data (free key at alphavantage.co)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Database URL (defaults to SQLite)
# DATABASE_URL=postgresql://username:password@localhost/hedgefund

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
